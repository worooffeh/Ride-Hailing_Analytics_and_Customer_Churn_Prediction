[Unit]
Description=RideWise FastAPI API
After=network.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/ridewise
Environment="PATH=/home/ec2-user/ridewise/.venv/bin"
Environment="PROJECT_ROOT=/home/ec2-user/ridewise"
ExecStart=/home/ec2-user/ridewise/.venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target