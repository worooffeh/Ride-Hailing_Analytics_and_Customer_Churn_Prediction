[Unit]
Description=RideWise Streamlit Frontend
After=network.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/ridewise
Environment="PATH=/home/ec2-user/ridewise/.venv/bin"
Environment="PROJECT_ROOT=/home/ec2-user/ridewise"
ExecStart=/home/ec2-user/ridewise/.venv/bin/streamlit run src/streamlit_app.py --server.address 127.0.0.1 --server.port 8501
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target